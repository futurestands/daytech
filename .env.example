# Application Runtime
PORT=3000
APP_URL="http://localhost:3000"

# Regional Defaults
DEFAULT_CURRENCY="UGX"
DEFAULT_TIMEZONE="Africa/Kampala"

# Backend-Only Administrative Access Key (NEVER prefix with VITE_)
# Optional for isolated local development. Production requires Firebase staff sign-in.
ADMIN_ACCESS_KEY=""

# Independent server-only secret. Use 32 or more random characters.
QUOTATION_LINK_SECRET=""

# Optional Official Company Channels (hidden until explicitly configured)
OFFICIAL_EMAIL=""
OFFICIAL_PHONE=""
OFFICIAL_WHATSAPP_NUMBER=""
OFFICIAL_ADDRESS=""

# Feature Flags (must be "true" to enable; "false" or unset keeps features disabled)
VITE_FEATURE_FIREBASE="false"
VITE_FEATURE_PAYMENTS="false"
VITE_FEATURE_GOOGLE_CALENDAR="false"
VITE_FEATURE_WHATSAPP="false"

# Phase 2 Optional Firebase Web SDK Configuration (used only when VITE_FEATURE_FIREBASE="true")
# Target Firebase Project ID from your configuration: daytech-bba8f
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Hide the live voice launcher when the integration is disabled
VITE_FEATURE_LIVE_VOICE="false"

# Optional Gemini API Key (server-side only for Live Voice & AI features)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Google Maps Platform Browser API Key (restricted to HTTP referrers)
VITE_GOOGLE_MAPS_API_KEY=""
